{
  "name": "wind-map",
  "version": "0.1.0",
  "description": "3D wind flow visualization on a globe (Electron + Three.js)",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --external:electron --outdir=dist --format=cjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test:nomads": "esbuild scripts/test-nomads.ts --bundle --platform=node --outfile=dist/test-nomads.cjs && node dist/test-nomads.cjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/three": "^0.169.0",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "three": "^0.169.0"
  }
}
